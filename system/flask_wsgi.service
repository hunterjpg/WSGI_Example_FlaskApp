[Unit]
Description=Flask-WSGI Webserver
After=network.target

[Service]
Type=simple
# PIDFile=/run/flask_wsgi.pid
User=flask
Group=nginx
WorkingDirectory=/var/www/flask_wsgi
Environment=/var/www/flask_wsgi/.venv/bin
# Environment="PATH=$PATH:/var/www/flask_wsgi/.venv/bin"
# ExecStartPre=rm -f /run/flask_wsgi.pid
ExecStart=/usr/bin/bash /var/www/flask_wsgi/run.sh
# ExecStart=/var/www/flask_wsgi/.venv/bin/uwsgi --ini /var/www/flask_wsgi/wsgi.ini 
ExecReload=/var/www/flask_wsgi/.venv/bin/uwsgi --reload
KillSignal=SIGQUIT
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
