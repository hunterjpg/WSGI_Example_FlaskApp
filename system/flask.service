[Unit]
Description=Flask Webserver
After=network.target

[Service]
Type=oneshot
User=flask
Group=nginx
WorkingDirectory=/var/www/flask_wsgi
Environment=/var/www/flask_wsgi/.venv/bin
ExecStart=/usr/bin/bash /var/www/flask_wsgi/run.sh
ExecReload=/var/www/flask_wsgi/.venv/bin/uwsgi --stop --no-orphans
TimeoutStartSec=1

[Install]
WantedBy=multi-user.target
RequiredBy=network.target
